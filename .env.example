# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=*,api.genclex.com,www.api.genclex.com

# Database (PostgreSQL / SQLite)
# Leave DB_NAME unset to use SQLite for local development, or configure Postgres below:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=genclex_db
# DB_USER=postgres
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://stemrn.vercel.app,https://stemrn-ashen.vercel.app,https://stemrn.softvencealpha.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000,https://stemrn.softvencealpha.com,https://api.genclex.com,https://www.api.genclex.com
CORS_ALLOW_ALL_ORIGINS=True

# AWS S3 Storage (Optional - leave AWS_STORAGE_BUCKET_NAME empty to use local filesystem storage)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Settings (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Frontend URLs
FRONTEND_VERIFY_EMAIL_URL=https://stemrn.vercel.app/auth
FRONTEND_RESET_PASSWORD_URL=https://stemrn.vercel.app/auth/new-password

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3000/billing
STRIPE_CANCEL_URL=http://localhost:3000/billing

# AI API Keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_api_key
